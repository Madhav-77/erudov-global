# ─── Client (VITE_*) — bundled into the browser build ────────────────────────
# Safe to expose, but lock EmailJS down with a domain allow-list in the
# EmailJS dashboard (Account → Security) so the public key can't be abused.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ─── Server only — set in Vercel Project Settings → Environment Variables ─────
# NEVER prefix these with VITE_. They are read by api/lead.ts and must not
# reach the client bundle.
SHEETS_WEBHOOK_URL=
WEBHOOK_SECRET=
